# Base URL of the API (apps/api)
VITE_API_URL=http://localhost:3001

# Where widget.js is served from — used to build the embed snippet shown on a
# client's Chat Assistant tab. One Cloudflare Worker serves every client; the
# per-client behaviour comes from data-client-id on each site's script tag.
VITE_WIDGET_URL=https://agent-widget.hyperboledigital.workers.dev/widget.js

# Clerk (dashboard auth). Get from your Clerk app: Configure → API Keys.
# This is the PUBLISHABLE key (safe to ship in the browser bundle) — never put
# a Clerk secret key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
