# Which LLM runs the chatbot: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voyage AI embeddings (optional — enables vector search over the knowledge base).
# If unset, knowledge search falls back to Postgres full-text search.
VOYAGE_API_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gmail OAuth (via Google Cloud Console). Send-only — used ONLY to send
# escalation emails to a human when the chatbot needs one. The platform does
# not read inboxes. Connect an account at /auth/gmail?clientId=<uuid>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Server
PORT=3001

# Comma-separated allow-list of browser origins allowed to call this API
# (the deployed dashboard URL; add the widget's origin(s) too if it ever
# needs to call authenticated routes). No default wildcard — required.
ALLOWED_ORIGINS=http://localhost:5173

# Clerk (dashboard auth). Get both from your Clerk app: Configure → API Keys.
# The API needs both keys (the publishable key to identify your Clerk
# instance, the secret key to verify sessions) — never expose the secret key
# to the browser. Note: NOT the NEXT_PUBLIC_-prefixed name Clerk's Next.js
# docs use; @clerk/express reads the plain var names below.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Signing secret for Clerk's webhook (Clerk Dashboard → Webhooks → your
# endpoint → Signing Secret). Only needed if any Clerk email template has
# "Delivered by Clerk" turned off — that setting makes Clerk stop sending the
# email itself and fire an email.created webhook instead, which
# lib/clerk-email-relay.ts listens for and relays through the platform's own
# Gmail sender. Endpoint URL to register in Clerk: <your API URL>/webhooks/clerk,
# subscribed to email.created.
CLERK_WEBHOOK_SECRET=whsec_...

# No env var for the platform email sender — a superadmin connects it from
# Overview → Platform email sender (Gmail OAuth, stored in
# platform_gmail_token). Independent of every client record, so onboarding,
# offboarding, or reconnecting any client's own Gmail never touches it.

# Comma-separated Clerk user IDs with full cross-tenant (superadmin) access —
# your team, not clients. Find a user's ID in the Clerk dashboard.
SUPERADMIN_USER_IDS=

# Encryption key for secrets at rest (Gmail refresh tokens). REQUIRED in prod —
# generate with: openssl rand -hex 32. Without it, tokens are stored plaintext.
ENCRYPTION_KEY=

# Abuse caps (optional — defaults in lib/usage.ts). GLOBAL_DAILY_LLM_CAP is the
# platform-wide circuit breaker across all clients.
CHAT_BURST_PER_MIN=20
CONTACT_PER_HOUR=15
DAILY_CONVERSATION_CAP=1000
GLOBAL_DAILY_LLM_CAP=5000

# Calendly (optional — or use direct link)
CALENDLY_API_KEY=

# Seats per client team (members + pending invites). Product default is 3.
TEAM_SEAT_LIMIT=3

# Baseline per-IP request ceiling for the API (per minute). /health is exempt.
# Must clear normal dashboard fan-out; 60 was low enough to look like an outage.
API_RATE_LIMIT_PER_MIN=300

# ── Prospect mockups + preview pages ─────────────────────────────────────────
# This API's own public URL. Prospect preview links (GET /p/:token) are opened
# by someone with no dashboard access, so they must be absolute and point here.
API_PUBLIC_URL=http://localhost:3001

# Image model for generated homepage concepts. OpenAI-only — Anthropic has no
# image generation API, so this is used regardless of LLM_PROVIDER. Requires
# OPENAI_API_KEY above; mockup generation disables itself without it.
OPENAI_IMAGE_MODEL=gpt-image-1

# Booking link shown as the CTA on a prospect preview page. Omit to hide it.
PROSPECT_BOOKING_URL=
