# Which LLM runs the chatbot: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voyage AI embeddings (optional — enables vector search over the knowledge base).
# If unset, knowledge search falls back to Postgres full-text search.
VOYAGE_API_KEY=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gmail OAuth (via Google Cloud Console). Send-only — used ONLY to send
# escalation emails to a human when the chatbot needs one. The platform does
# not read inboxes. Connect an account at /auth/gmail?clientId=<uuid>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Server
PORT=3001
API_SECRET=your-random-secret-for-widget-auth

# Calendly (optional — or use direct link)
CALENDLY_API_KEY=
